node_modules/
dist/
.next/
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
*.log
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# workflow-agent scratch snapshots — never commit
*_models.json
modelsdev.json

# regenerable graphify artifacts (rebuilt by post-commit hook)
graphify-out/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# derived: the SQLite projection is rebuildable from the trajectory (V0-02)
.harness/state.db
.harness/state.db-wal
.harness/state.db-shm
# `replay` sets aside a stale projection before rebuilding; it is a local artefact,
# reproducible from the log, and not part of the record.
.harness/state.db.stale-*

# derived: the observability surface is a rendering of the trajectory (ADR-0053).
# It embeds the record's contents verbatim, so committing it would duplicate the log
# into an unreviewed artefact and hand the secret scanner a second copy to miss.
.harness/dashboard.html

# Transient runner state: a pid and a run id, meaningful only while a run is live.
# Committing it would assert a lock that is not held.
docs/10-research/experiments/*/run.lock

# EXP-27 collector runtime state: rebuilt by running the collector; not evidence.
docs/10-research/experiments/exp27/collector-state.json

# Agent transcripts. These are multi-megabyte verbatim records of dispatched runs: they carry
# whatever an agent read, printed or was told, and they sit inside the repository. Nothing in
# them belongs in the record, and a single `git add -A` would commit all of them — which is not
# hypothetical, because `git add -A` swept four brief files into a commit on 20 August 2026.
.harness/dispatch/
# Briefs written for a dispatched agent, which live in a clone's root by convention.
brief-*.md

# Raw private-corpus extracts. EXP-01 mines ../hireable-3.0 and ../jobboard-v2, whose NAMES and
# AGGREGATE METRICS may be recorded (AGENTS.md) but whose PR titles, commit messages and file
# paths may never be. The derived data files are referenced by findings documents and must not
# become committable if anyone regenerates them.
data/
*-prs.json
red-cells-evidence.json

# Pseudonym maps back to private-corpus identifiers. Local only, never published.
*.local.json
